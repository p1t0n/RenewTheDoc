<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:l="clr-namespace:RenewTheDoc.App.Localization"
             xmlns:pages="clr-namespace:RenewTheDoc.App.Pages"
             x:Class="RenewTheDoc.App.Pages.DocumentListPage"
             x:DataType="pages:DocumentListPage"
             Title="{l:Translate DocumentsTitle}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="+" Clicked="OnAddClicked" />
    </ContentPage.ToolbarItems>

    <CollectionView x:Name="DocumentsView">
        <CollectionView.EmptyView>
            <Label Text="{l:Translate EmptyList}"
                   HorizontalOptions="Center" VerticalOptions="Center"
                   Margin="24" />
        </CollectionView.EmptyView>
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="pages:DocumentListItem">
                <Grid Padding="16,12" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                    <Label Grid.Row="0" Grid.Column="0" Text="{Binding Name}" FontSize="17" FontAttributes="Bold" />
                    <Label Grid.Row="1" Grid.Column="0" Text="{Binding ExpiresText}" FontSize="13" TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" />
                    <Border Grid.Row="0" Grid.Column="1" Grid.RowSpan="2"
                            BackgroundColor="{Binding StateColor}"
                            StrokeThickness="0" StrokeShape="RoundRectangle 8"
                            Padding="8,4" VerticalOptions="Center">
                        <Label Text="{Binding StateText}" TextColor="White" FontSize="12" />
                    </Border>
                </Grid>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>

</ContentPage>

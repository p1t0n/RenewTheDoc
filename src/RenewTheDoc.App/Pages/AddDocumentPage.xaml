<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:l="clr-namespace:RenewTheDoc.App.Localization"
             x:Class="RenewTheDoc.App.Pages.AddDocumentPage"
             Title="{l:Translate AddDocumentTitle}">

    <ScrollView>
        <VerticalStackLayout Padding="18,10" Spacing="2">

            <Label Text="{l:Translate NameLabel}" Style="{StaticResource FieldLabel}" />
            <Border Style="{StaticResource Field}">
                <Entry x:Name="NameEntry" Placeholder="{l:Translate NamePlaceholder}" />
            </Border>

            <Label Text="{l:Translate ExpiryDateLabel}" Style="{StaticResource FieldLabel}" />
            <Border Style="{StaticResource Field}">
                <DatePicker x:Name="ExpiryPicker" HorizontalOptions="Fill" />
            </Border>

            <Label Text="{l:Translate RemindBeforeLabel}" Style="{StaticResource FieldLabel}" />
            <Border Style="{StaticResource Field}" Padding="0">
                <Grid x:Name="SegmentGrid" ColumnDefinitions="*,*,*,*" />
            </Border>
            <Border Style="{StaticResource Field}" x:Name="CustomDaysBorder" IsVisible="False" Margin="0,8,0,0">
                <Entry x:Name="CustomDaysEntry" Keyboard="Numeric" Placeholder="{l:Translate CustomDaysPlaceholder}" />
            </Border>

            <Label Text="{l:Translate NoteLabel}" Style="{StaticResource FieldLabel}" />
            <Border Style="{StaticResource Field}">
                <Entry x:Name="NoteEntry" />
            </Border>

            <Button Text="{l:Translate SaveDocument}" Style="{StaticResource PrimaryButton}" Clicked="OnSaveClicked" Margin="0,20,0,0" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>

<?xml version="1.0" encoding="UTF-8" ?>
<!-- Compass design tokens (REN-14). Suffix L/D = light/dark; consumed via AppThemeBinding in Styles.xaml. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Color x:Key="BgL">#F3F6F9</Color>
    <Color x:Key="BgD">#131A21</Color>
    <Color x:Key="SurfaceL">#FFFFFF</Color>
    <Color x:Key="SurfaceD">#1C2530</Color>
    <Color x:Key="InkL">#1E2A36</Color>
    <Color x:Key="InkD">#E7EDF3</Color>
    <Color x:Key="MutedL">#68788A</Color>
    <Color x:Key="MutedD">#8CA0B3</Color>
    <Color x:Key="PrimaryL">#2F6DB0</Color>
    <Color x:Key="PrimaryD">#5D9BD8</Color>
    <Color x:Key="OnPrimaryL">#FFFFFF</Color>
    <Color x:Key="OnPrimaryD">#0E1620</Color>
    <Color x:Key="OkL">#31855C</Color>
    <Color x:Key="OkD">#5CBB8C</Color>
    <Color x:Key="WarnL">#C77D1D</Color>
    <Color x:Key="WarnD">#E0A24A</Color>
    <Color x:Key="BadL">#C4473B</Color>
    <Color x:Key="BadD">#E07A6C</Color>
    <Color x:Key="LineL">#E1E8EF</Color>
    <Color x:Key="LineD">#2A3644</Color>

    <!-- Kept for MauiSplashScreen/MauiIcon references -->
    <Color x:Key="Primary">#2F6DB0</Color>
</ResourceDictionary>

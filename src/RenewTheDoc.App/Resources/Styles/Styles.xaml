<?xml version="1.0" encoding="UTF-8" ?>
<!--
  Compass patterns (REN-14):
  · rows/fields radius 10, small buttons 8; state shown by 4px rail + colored number, never pill badges
  · group headers + field labels: 11pt ExtraBold uppercase, wide tracking, muted
  · one family (Manrope), three weights: Regular 400 / SemiBold 600 / ExtraBold 800
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource BgL}, Dark={StaticResource BgD}}" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="FontFamily" Value="ManropeRegular" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkL}, Dark={StaticResource InkD}}" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <Style TargetType="Label" x:Key="ScreenTitle">
        <Setter Property="FontFamily" Value="ManropeExtraBold" />
        <Setter Property="FontSize" Value="21" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkL}, Dark={StaticResource InkD}}" />
    </Style>

    <Style TargetType="Label" x:Key="GroupHeader">
        <Setter Property="FontFamily" Value="ManropeExtraBold" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="CharacterSpacing" Value="1.6" />
        <Setter Property="TextTransform" Value="Uppercase" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MutedL}, Dark={StaticResource MutedD}}" />
        <Setter Property="Padding" Value="20,18,20,8" />
    </Style>

    <Style TargetType="Label" x:Key="RowName">
        <Setter Property="FontFamily" Value="ManropeExtraBold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkL}, Dark={StaticResource InkD}}" />
    </Style>

    <Style TargetType="Label" x:Key="RowDate">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MutedL}, Dark={StaticResource MutedD}}" />
    </Style>

    <Style TargetType="Label" x:Key="NumBig">
        <Setter Property="FontFamily" Value="ManropeExtraBold" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

    <Style TargetType="Label" x:Key="NumUnit">
        <Setter Property="FontFamily" Value="ManropeSemiBold" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="CharacterSpacing" Value="0.8" />
        <Setter Property="TextTransform" Value="Uppercase" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MutedL}, Dark={StaticResource MutedD}}" />
    </Style>

    <Style TargetType="Label" x:Key="FieldLabel">
        <Setter Property="FontFamily" Value="ManropeExtraBold" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="CharacterSpacing" Value="1.4" />
        <Setter Property="TextTransform" Value="Uppercase" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MutedL}, Dark={StaticResource MutedD}}" />
        <Setter Property="Margin" Value="2,12,2,4" />
    </Style>

    <Style TargetType="Border" x:Key="Row">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceL}, Dark={StaticResource SurfaceD}}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 10" />
        <Setter Property="Margin" Value="14,0,14,8" />
    </Style>

    <Style TargetType="Entry">
        <Setter Property="FontFamily" Value="ManropeRegular" />
        <Setter Property="FontSize" Value="14.5" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkL}, Dark={StaticResource InkD}}" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource MutedL}, Dark={StaticResource MutedD}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>

    <Style TargetType="DatePicker">
        <Setter Property="FontFamily" Value="ManropeRegular" />
        <Setter Property="FontSize" Value="14.5" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkL}, Dark={StaticResource InkD}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>

    <!-- Surface wrapper that gives Entry/DatePicker the Compass field look -->
    <Style TargetType="Border" x:Key="Field">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceL}, Dark={StaticResource SurfaceD}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LineL}, Dark={StaticResource LineD}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 10" />
        <Setter Property="Padding" Value="12,2" />
    </Style>

    <Style TargetType="Button" x:Key="PrimaryButton">
        <Setter Property="FontFamily" Value="ManropeExtraBold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PrimaryL}, Dark={StaticResource PrimaryD}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnPrimaryL}, Dark={StaticResource OnPrimaryD}}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="0,13" />
    </Style>

    <Style TargetType="Button" x:Key="OutlineButton">
        <Setter Property="FontFamily" Value="ManropeExtraBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PrimaryL}, Dark={StaticResource PrimaryD}}" />
        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource PrimaryL}, Dark={StaticResource PrimaryD}}" />
        <Setter Property="BorderWidth" Value="1.5" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,5" />
    </Style>

    <!-- Segmented remind-before control: unselected / selected -->
    <Style TargetType="Button" x:Key="Segment">
        <Setter Property="FontFamily" Value="ManropeSemiBold" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceL}, Dark={StaticResource SurfaceD}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MutedL}, Dark={StaticResource MutedD}}" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="0,10" />
        <Setter Property="BorderWidth" Value="0" />
    </Style>

    <Style TargetType="Button" x:Key="SegmentSelected" BasedOn="{StaticResource Segment}">
        <Setter Property="FontFamily" Value="ManropeExtraBold" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PrimaryL}, Dark={StaticResource PrimaryD}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnPrimaryL}, Dark={StaticResource OnPrimaryD}}" />
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{AppThemeBinding Light={StaticResource BgL}, Dark={StaticResource BgD}}" />
        <Setter Property="Shell.ForegroundColor" Value="{AppThemeBinding Light={StaticResource PrimaryL}, Dark={StaticResource PrimaryD}}" />
        <Setter Property="Shell.TitleColor" Value="{AppThemeBinding Light={StaticResource InkL}, Dark={StaticResource InkD}}" />
        <Setter Property="Shell.NavBarHasShadow" Value="False" />
    </Style>

    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{AppThemeBinding Light={StaticResource BgL}, Dark={StaticResource BgD}}" />
    </Style>
</ResourceDictionary>

{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "mcp__linear-server",
      "mcp__linear-server__list_issues",
      "mcp__linear-server__get_issue",
      "mcp__linear-server__save_issue",
      "mcp__linear-server__save_comment",
      "mcp__linear-server__list_comments",
      "mcp__linear-server__list_issue_labels",
      "mcp__linear-server__get_workspace",
      "Bash(rtk:*)",
      "Bash(dotnet:*)",
      "Bash(adb:*)",
      "Bash(emulator:*)",
      "Bash(ralph/emulator.sh:*)",
      "Bash(./ralph/emulator.sh:*)",
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(sed:*)",
      "Bash(mkdir:*)",
      "Bash(mv:*)",
      "Bash(cp:*)",
      "Bash(python3:*)",
      "Bash(unzip:*)",
      "Bash(awk:*)",
      "Bash(diff:*)",
      "Bash(DEVELOPER_DIR=*)"
    ],
    "deny": [
      "Bash(rtk exec:*)",
      "Bash(rtk proxy:*)",
      "Bash(git push --force:*)",
      "Bash(rtk git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(rtk git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(rtk git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(rtk git clean:*)",
      "Bash(gh pr merge:*)",
      "Bash(rtk gh pr merge:*)",
      "Bash(rm -rf:*)",
      "Bash(rtk rm:*)",
      "Bash(curl:*)",
      "Bash(rtk curl:*)",
      "Bash(npm publish:*)"
    ]
  }
}
